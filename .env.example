# 이 파일을 .env.local 로 복사해서 값을 채우세요.
# VITE_ 로 시작하는 값만 브라우저에 들어갑니다 (공개돼도 되는 값만!)
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=

# 아래는 서버(/api)에서만 쓰는 비밀 키 — 절대 VITE_ 를 붙이지 마세요
DATA_GO_KR_KEY=
KAKAO_REST_KEY=
VISIT_JEJU_API=
# AI 가이드: 지금은 Gemini(테스트용), 나중에 Claude 로 바꿀 예정
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=
ANTHROPIC_API_KEY=

# 제주데이터허브 버스 노선 API (공공데이터포털 15074254 → jejudatahub.net 에서 발급)
JEJU_BUS_KEY=
